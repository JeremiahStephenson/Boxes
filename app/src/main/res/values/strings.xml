    <string name="guide_welcome_title">Create with confidence</string>
    <string name="guide_welcome_desc">BitShape turns a simple grid into pixel art. Choose a color and shape, draw on the canvas, then use layers to build up your creation.</string>
    <string name="guide_on_this_page">On this page</string>

    <string name="guide_basic_drawing">Start drawing</string>
    <string name="guide_basic_drawing_desc">The canvas responds to taps, drags, and two-finger gestures.</string>
    <string name="guide_basic_drawing_1_label">Draw continuously</string>
    <string name="guide_basic_drawing_1_desc">Drag one finger across the canvas to paint several boxes in a single stroke.</string>
    <string name="guide_basic_drawing_2_label">Place one shape</string>
    <string name="guide_basic_drawing_2_desc">Tap a box to paint it with the selected color and shape—or to use the active tap tool.</string>
    <string name="guide_basic_drawing_3_label">Zoom and move</string>
    <string name="guide_basic_drawing_3_desc">Pinch with two fingers to zoom. While zoomed in, use two fingers to move around the canvas.</string>

    <string name="guide_tool_icon_bar">Toolbar</string>
    <string name="guide_tool_icon_bar_desc">Keep your most-used drawing controls within reach.</string>
    <string name="guide_tool_icon_bar_1_label">Choose a color</string>
    <string name="guide_tool_icon_bar_1_desc">Open the palette to set the drawing color or reuse a color from your recent choices.</string>
    <string name="guide_tool_icon_bar_2_label">Choose a shape</string>
    <string name="guide_tool_icon_bar_2_desc">Tap the shape preview between the color palette and brush buttons. Its appearance changes to show your currently selected shape.</string>
    <string name="guide_tool_icon_bar_3_label">Change the tap tool</string>
    <string name="guide_tool_icon_bar_3_desc">Tap to cycle between Draw, Eyedropper, and Fill. The icon shows which mode is active.</string>
    <string name="guide_tool_icon_bar_4_label">Undo</string>
    <string name="guide_tool_icon_bar_4_desc">Reverse the most recent drawing action on the current layer.</string>
    <string name="guide_tool_icon_bar_5_label">Reset the view</string>
    <string name="guide_tool_icon_bar_5_desc">Return the canvas to its centered, fit-to-screen position after zooming or panning.</string>

    <string name="guide_drawer_tools">Tools and display</string>
    <string name="guide_drawer_tools_desc">Open the side menu to select specialized tools and change how the canvas is displayed.</string>
    <string name="guide_drawer_menu_1_label">Fill</string>
    <string name="guide_drawer_menu_1_desc">Tap a box to recolor the connected area that has the same color and shape.</string>
    <string name="guide_drawer_menu_2_label">Eyedropper</string>
    <string name="guide_drawer_menu_2_desc">Tap a painted box to make its color and shape your current selection.</string>
    <string name="guide_drawer_menu_3_label">Eraser</string>
    <string name="guide_drawer_menu_3_desc">Drag or tap to remove artwork from the selected layer without affecting other layers.</string>
    <string name="guide_drawer_menu_4_label">Select and move</string>
    <string name="guide_drawer_menu_4_desc">Drag over an area to select it, then use the direction controls to move that artwork on the layer.</string>
    <string name="guide_drawer_menu_5_label">Grid</string>
    <string name="guide_drawer_menu_5_desc">Show or hide the grid lines between boxes.</string>
    <string name="guide_drawer_menu_6_label">Transparency background</string>
    <string name="guide_drawer_menu_6_desc">Show or hide the checkerboard used to identify transparent areas.</string>

    <string name="guide_project_actions">Save, import, and export</string>
    <string name="guide_project_actions_desc">The side menu also contains project and file actions.</string>
    <string name="guide_drawer_menu_7_label">Edit project</string>
    <string name="guide_drawer_menu_7_desc">Change the project name or resize its grid by editing the row and column counts.</string>
    <string name="guide_drawer_menu_8_label">Save project</string>
    <string name="guide_drawer_menu_8_desc">Save your current work to the project gallery. BitShape also saves when you leave the editor.</string>
    <string name="guide_drawer_menu_9_label">Export PNG</string>
    <string name="guide_drawer_menu_9_desc">Create a PNG file at your chosen output size and save it to your device.</string>
    <string name="guide_drawer_menu_10_label">Share</string>
    <string name="guide_drawer_menu_10_desc">Create a PNG and send it directly to another app.</string>
    <string name="guide_drawer_menu_11_label">Import image</string>
    <string name="guide_drawer_menu_11_desc">Choose an image from your device and place it on the currently selected layer.</string>
    <string name="guide_drawer_menu_12_label">Clear layer</string>
    <string name="guide_drawer_menu_12_desc">Remove every painted box from the selected layer. Other layers remain unchanged.</string>

    <string name="guide_layers">Layers in the side menu</string>
    <string name="guide_layers_desc">Select the layer you want to draw on, control its visibility, or open the layer editing screen.</string>
    <string name="guide_layer_options_1_label">Select a layer</string>
    <string name="guide_layer_options_1_desc">Tap a layer name to make it active. New drawing and editing actions are applied to the selected layer.</string>
    <string name="guide_layer_options_3_label">Add a layer</string>
    <string name="guide_layer_options_3_desc">Tap Add Layer below the layer list to create another layer. A project can contain up to 10 layers.</string>
    <string name="guide_layer_options_2_label">Show or hide a layer</string>
    <string name="guide_layer_options_2_desc">Use the visibility control beside a layer to preview your work with that layer shown or hidden.</string>
    <string name="guide_layer_edit_1_label">Open the layer editing screen</string>
    <string name="guide_layer_edit_1_desc">Tap the pencil icon beside the Layers heading to reorder, rename, or delete layers.</string>
    <string name="guide_layer_edit_screen">Layer editing screen</string>
    <string name="guide_layer_edit_screen_desc">Use the dedicated editing screen to inspect, organize, and manage the layers in your project.</string>
    <string name="guide_layer_edit_2_label">Show transparent areas</string>
    <string name="guide_layer_edit_2_desc">Tap the checkerboard icon in the top bar to turn the PNG background on or off behind every layer preview. The checkerboard makes transparent pixels easier to see.</string>
    <string name="guide_layer_edit_3_label">Change draw order</string>
    <string name="guide_layer_edit_3_desc">Drag the handle beside a layer. Layers nearer the top are drawn over layers below them.</string>
    <string name="guide_layer_edit_4_label">Rename a layer</string>
    <string name="guide_layer_edit_4_desc">Tap the pencil beside a layer to give it a clear, memorable name.</string>
    <string name="guide_layer_edit_5_label">Delete a layer</string>
    <string name="guide_layer_edit_5_desc">Tap the trash icon to permanently remove that layer after confirmation. At least one layer is always kept.</string>

    <string name="guide_tip_title">A good first project</string>
    <string name="guide_tip_desc">Start on one layer with a small grid, draw the main silhouette, then add separate layers for details and the background.</string>
</resources>
